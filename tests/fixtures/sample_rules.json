        "ruleScopeARIs": ["ari:cloud:jira:02f93c22-4123-4e29-a35e-435c1aab8e00:project/10000"],
        "trigger": {"component": "TRIGGER", "type": "jira.jql.scheduled",
                    "value": {"jql": "project = CFIT AND status = Qualification", "schedule": {"rRule": "FREQ=WEEKLY;BYDAY=MO"}}},
        "components": [
          {"component": "ACTION", "type": "jira.issue.outgoing.slack",
           "value": {"webhookUrl": "https://hooks.slack.com/services/T000/B000/FAKESECRET",
                     "message": "Bug en attente : {{issue.key}}"}}
